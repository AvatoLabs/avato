# LobeChat Development Environment Configuration
# ⚠️ DO NOT USE THESE VALUES IN PRODUCTION!

# Skip login in local dev (server + client hints). Never enable in production.
NOAUTH_MODE=1
NEXT_PUBLIC_NOAUTH_MODE=1
# Optional fixed DB user id when using NOAUTH_MODE
# NOAUTH_USER_ID=local-user

# Application
APP_URL=http://localhost:3010

# Allow access to private IP addresses (localhost services) in development
# https://lobehub.com/docs/self-hosting/environment-variables/basic#ssrf-allow-private-ip-address
SSRF_ALLOW_PRIVATE_IP_ADDRESS=1

# Secrets (pre-generated for development only)
KEY_VAULTS_SECRET=ww+0igxjGRAAR/eTNFQ55VmhQB5KE5trFZseuntThJs=
AUTH_SECRET=ww+0igxjGRAAR/eTNFQ55VmhQB5KE5trFZseuntThJs=

# Database (PostgreSQL)
# 1) Copy docker-compose/dev/.env.example → docker-compose/dev/.env（LOBE_DB_NAME、POSTGRES_PASSWORD、POSTGRES_HOST_PORT 须与下面 URL 端口一致）
# 2) pnpm dev:docker — 启动 Postgres / Redis / RustFS / SearXNG
# 3) pnpm db:migrate — 建表（会读取 .env.local，与 Next 一致）
DATABASE_URL=postgresql://postgres:change_this_password_on_production@localhost:5432/lobechat
DATABASE_DRIVER=node

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=lobechat
REDIS_TLS=0

# Redis-backed async runtime (optional)
# AGENT_RUNTIME_MODE=queue

# Remote Device Gateway (optional, for Web/mobile -> Desktop tool execution)
# DEVICE_GATEWAY_URL=http://localhost:8787
# DEVICE_GATEWAY_SERVICE_TOKEN=change_this_device_gateway_service_token

# S3 Storage (RustFS)
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=change_this_password_on_production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=lobe
S3_ENABLE_PATH_STYLE=1
# S3_SET_ACL=1  # optional legacy opt-in; app does not set object ACL (default off)

# LLM vision uses base64 to avoid S3 presigned URL issues in development
LLM_VISION_IMAGE_USE_BASE64=1

# Search (SearXNG)
SEARXNG_URL=http://localhost:8180

# Proxy (Optional)
# HTTP_PROXY=http://localhost:7890
# HTTPS_PROXY=http://localhost:7890

# AI Model API Keys (Required for chat functionality)
# ANTHROPIC_API_KEY=sk-ant-xxx
# ANTHROPIC_PROXY_URL=https://api.anthropic.com

# OPENAI_API_KEY=sk-xxx
# OPENAI_PROXY_URL=https://api.openai.com/v1
