# Copy to `.env` next to docker-compose.yml on the Canary host.
# `deployCanaryTar.sh` uploads `docker-compose/canary/.env` when present.

LOBE_PORT=3211
LOBE_IMAGE=canary-lobe
LOBE_IMAGE_TAG=deploy

# Must be http://127.0.0.1:3210 inside the lobe container (app port), not 3211.
INTERNAL_APP_URL=http://127.0.0.1:3210

LOBE_DB_NAME=lobechat_canary
POSTGRES_PASSWORD=change_this_password_on_production

RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=change_this_password_on_production
RUSTFS_LOBE_BUCKET=lobe-canary
RUSTFS_PORT=9002
RUSTFS_ADMIN_PORT=9003

# Same host:port as RUSTFS published port — clients (browser/mobile) PUT here; not localhost.
S3_ENDPOINT=http://8.217.101.26:9002

KEY_VAULTS_SECRET=
AUTH_SECRET=
# Keep Server Action ids stable across rebuilds/restarts. Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

AGENT_RUNTIME_MODE=queue
VIRTUAL_HOST=canary.turingmesh.com
